# TallyInsight — Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ==================== JWT SHARED SECRET ====================
# REQUIRED — app will refuse to start without a strong key.
# Must be the SAME value as TallyBridge SECRET_KEY.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# JWT_SECRET_KEY takes priority; SECRET_KEY is accepted as an alias
# so you can point both services at the same .env file or copy the value.
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_secrets_token_urlsafe_48

# JWT algorithm — must match TallyBridge ALGORITHM (default HS256)
JWT_ALGORITHM=HS256

# Optional: JWT issuer claim for extra validation (leave blank to skip)
# JWT_ISSUER=tallybots

# ==================== TALLYBRIDGE URL ====================
# URL where TallyBridge is running (used for cross-service calls)
TALLYBRIDGE_URL=http://localhost:8451

# ==================== TALLY ERP CONNECTION ====================
# Tally ERP server address and port (default: localhost:9000)
# TALLY_SERVER=localhost
# TALLY_PORT=9000

# ==================== DATABASE ====================
# SQLite path (default: ./tally.db)
# DATABASE_PATH=./tally.db

# ==================== API ====================
# Host and port for TallyInsight API (default: 0.0.0.0:8401)
# API_HOST=0.0.0.0
# API_PORT=8401